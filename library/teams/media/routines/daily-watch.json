{
  "description": "Morning shortlist: the news worth the business's attention",
  "agent": "watcher",
  "trigger": {
    "manual": true
  },
  "blocks": [
    {
      "id": "news",
      "type": "read",
      "source": "rss",
      "feeds": [
        "https://example.com/feed.xml"
      ],
      "max_age_days": 2,
      "dedupe": "link"
    },
    {
      "id": "pick",
      "type": "ai",
      "prompt": "prompts/watch.md",
      "keep": "relevant",
      "rank": "score",
      "limit": 10
    },
    {
      "id": "report",
      "type": "act",
      "action": "airth.report",
      "fields": {
        "title": "Daily watch",
        "pillar": "{{answer.pillar}}",
        "line": "{{title}}",
        "why": "{{answer.why}}",
        "link": "{{link}}"
      }
    }
  ]
}
